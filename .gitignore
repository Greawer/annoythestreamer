# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage*

# User-provided emoji images
/public/img/emoji/*.png
/public/img/emoji/*.jpg
/public/img/emoji/*.jpeg
!/public/img/emoji/.gitkeep

# User-provided soundboard audio
/public/sounds/soundboard/*.[mM][pP]3
/public/sounds/soundboard/*.[mM]4[aA]
/public/sounds/soundboard/*.[wW][aA][vV]

# Local legacy soundboard configuration
/public/sounds/soundboard/_sound-list.txt

# Runtime-generated TTS audio and temporary output
/public/sounds/tts/*.mp3
/public/sounds/tts/*.tmp
/public/sounds/tts/*.part
